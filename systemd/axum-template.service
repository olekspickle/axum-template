[Unit]
Description=axum-template web server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=axum-template
Group=axum-template
WorkingDirectory=/opt/axum-template

# Secrets (ADMIN_PASSWORD, SURREAL_PASSWORD); created by systemd/setup.sh
EnvironmentFile=-/etc/axum-template.env

# Path to the binary
ExecStart=/opt/axum-template/axum-template

# Restart behavior
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
